  "keyFeatures": [
    "100+ browser-playable HTML5 and Flash games",
    "In-browser retro console emulation via EmulatorJS (NES, SNES, N64, GBA, PS1, and more)",
    "PWA support with service worker caching for offline play",
    "Tab cloaking (custom title/favicon via localStorage)",
    "Virtual gamepad and physical gamepad support",
    "Save states, fast-forward, rewind, slow motion",
    "Cheat code support and GLSL shader rendering",
    "Experimental netplay multiplayer",
    "Multi-language localization (15+ languages)",
    "Google Analytics and visit counter integration"
  ],
